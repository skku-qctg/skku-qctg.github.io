<div class="news">
  {% if site.news != blank %}
    {% assign news = site.news | sort: 'date' | reverse %}

    {% if include.limit %}
      {% if page.announcements.limit %}
        {% assign news_limit = page.announcements.limit %}
      {% else %}
        {% assign news_limit = news | size %}
      {% endif %}
      {% include news_table.liquid items=news limit=news_limit scrollable=page.announcements.scrollable %}
    {% else %}
      <ul class="tab" data-tab="notice-category-content">
        <li id="notice-all" class="active"><a href="#">All</a></li>
        {% for category in page.display_categories %}
          {% assign category_id = category | slugify %}
          <li id="notice-{{ category_id }}"><a href="#">{{ category }}</a></li>
        {% endfor %}
      </ul>

      <ul id="notice-category-content" class="tab-content">
        <li class="active">
          {% include news_table.liquid items=news %}
        </li>
        {% for category in page.display_categories %}
          {% assign categorized_news = news | where: 'category', category %}
          <li>
            {% include news_table.liquid items=categorized_news %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  {% else %}
    <p>No notices so far...</p>
  {% endif %}
</div>
