{% assign news_items = include.items %}
{% assign news_limit = news_items | size %}
{% if include.limit %}
  {% assign news_limit = include.limit %}
{% endif %}

{% if news_items != blank %}
  <div
    class="table-responsive"
    {% if include.scrollable and news_items.size > 3 %}
      style="max-height: 60vw"
    {% endif %}
  >
    <table class="table table-sm table-borderless">
      <thead>
        <tr>
          <th scope="col" style="width: 20%">Date</th>
          <th scope="col">Title</th>
          <th scope="col" style="width: 15%">Category</th>
        </tr>
      </thead>
      <tbody>
        {% for item in news_items limit: news_limit %}
          <tr>
            <td>{{ item.date | date: '%b %d, %Y' }}</td>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
            <td>{{ item.category }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% else %}
  <p>No notices in this category.</p>
{% endif %}
